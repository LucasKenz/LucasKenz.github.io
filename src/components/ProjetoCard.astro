---
import type { Lang, Projeto } from '@content/types';
import { ui } from '@/i18n/ui';
import Midia from './Midia.astro';
import Tags from './Tags.astro';

interface Props { projeto: Projeto; lang: Lang }
const { projeto: p, lang } = Astro.props;
const base = lang === 'pt' ? '' : '/en';
const href = p.estudoDeCaso ? `${base}/projetos/${p.slug}` : p.codigoUrl;
---
<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-panel transition-[border-color,translate] duration-300 ease-out-soft hover:-translate-y-1 hover:border-accent/60"
  data-card
  data-stack={[...p.stack, ...p.areas.map((a) => `area:${a}`)].join('|')}
>
  {p.midia ? (
    <figure class="relative border-b border-line">
      <Midia midia={p.midia} lang={lang} class="block aspect-video w-full object-cover object-top" />
      {p.midia.legenda && <figcaption class="eyebrow absolute bottom-2.5 left-2.5 rounded-sm border border-line bg-panel px-2 py-0.5 text-ink">{p.midia.legenda[lang]}</figcaption>}
    </figure>
  ) : (

    <div class="relative flex aspect-video flex-col justify-end overflow-hidden border-b border-line bg-[#0a0f1e] p-5 text-[#e8ecf6]">
      <div class="lombada absolute inset-x-0 top-0 h-1.5"></div>
      <span aria-hidden="true" data-marca={p.nome.slice(0, 3).toUpperCase()} class="pointer-events-none absolute -top-3 -right-2 font-mono text-[5.5rem] leading-none font-bold text-white/5 select-none before:content-[attr(data-marca)]"></span>
      <dl class="grid grid-cols-3 gap-3">
        {p.numeros.map((n) => (
          <div class="flex flex-col-reverse justify-end">
            <dt class="font-mono text-[0.65rem] tracking-wide text-[#a1abc6] uppercase">{n.rotulo[lang]}</dt>
            <dd class="font-mono text-xl font-semibold text-[#7a9bff]">{n.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    <p class="eyebrow">{p.parceiro[lang]} · {p.ano}</p>
    <h2 class="mt-1.5 text-lg font-semibold tracking-tight">
      {href ? <a href={href} class="after:absolute after:inset-0">{p.nome}</a> : p.nome}
    </h2>
    <p class="mt-1.5 text-sm text-muted">{p.frase[lang]}</p>
    <Tags itens={p.stack} class="mt-4" />
    <div class="relative z-10 mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4 text-sm font-semibold">
      {p.demoUrl && <a href={p.demoUrl} class="text-accent hover:underline">{ui.abrirSite[lang]} ↗</a>}
      {p.codigoUrl && <a href={p.codigoUrl} class="text-accent hover:underline">{ui.codigo[lang]} ↗</a>}
      {p.estudoDeCaso && <a href={`${base}/projetos/${p.slug}`} class="text-accent hover:underline">{ui.estudoDeCaso[lang]} →</a>}
      {!p.codigoUrl && <span class="font-normal text-muted">{ui.codigoPrivado[lang]}</span>}
    </div>
  </div>
</article>
