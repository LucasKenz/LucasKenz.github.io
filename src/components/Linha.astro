---
// A dated row with a floating preview on hover/focus (pattern from direction C).
// The preview follows the pointer when JS is on; without JS it sits at the row's right edge.
import type { Lang, Numero } from '@content/types';

interface Props {
  lang: Lang;
  quando: string;
  titulo: string;
  href?: string;
  externo?: boolean;
  subtitulo?: string;
  texto: string;
  preview?: { src: string; alt: string; width: number; height: number };
  numeros?: Numero[];
  tags?: string[];
}
const { lang, quando, titulo, href, externo, subtitulo, texto, preview, numeros, tags } = Astro.props;
const temPreview = Boolean(preview || numeros?.length);
---
<li class="linha group relative grid gap-1 rounded-lg px-3 py-4 transition-colors duration-200 hover:bg-panel focus-within:bg-panel sm:grid-cols-[8.5rem_1fr] sm:gap-5" data-linha={temPreview ? '' : undefined}>
  <span class="eyebrow pt-1">{quando}</span>
  <div>
    <h3 class="font-semibold">
      {href ? (
        <a href={href} class="after:absolute after:inset-0" {...(externo ? { rel: 'noopener' } : {})}>
          {titulo}{externo ? ' ↗' : ''}
        </a>
      ) : titulo}
      {subtitulo && <span class="font-normal text-muted"> · {subtitulo}</span>}
    </h3>
    <p class="mt-1 text-muted">{texto}</p>
    {tags && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => <li class="rounded-[3px] border border-line px-1.5 py-px font-mono text-xs text-muted">{t}</li>)}
      </ul>
    )}
  </div>
  {temPreview && (
    <div class="preview pointer-events-none absolute top-1/2 right-0 z-20 hidden w-64 rotate-[-2deg] overflow-hidden rounded-lg border border-line bg-panel opacity-0 shadow-xl transition-[opacity,rotate] duration-200 ease-out-soft group-hover:rotate-0 group-hover:opacity-100 group-focus-within:opacity-100 lg:block" aria-hidden="true">
      {preview ? (
        <img src={preview.src} alt="" width={preview.width} height={preview.height} loading="lazy" class="block aspect-video w-full object-cover object-top" />
      ) : (
        <>
        <div class="lombada h-1.5"></div>
        <dl class="grid grid-cols-3 gap-2 p-4">
          {numeros!.map((n) => (
            <div class="flex flex-col-reverse justify-end">
              <dt class="font-mono text-[0.65rem] text-muted uppercase">{n.rotulo[lang]}</dt>
              <dd class="font-mono text-lg font-semibold text-accent">{n.valor}</dd>
            </div>
          ))}
        </dl>
        </>
      )}
    </div>
  )}
</li>

<style>
  /* With JS the preview leaves the row and follows the pointer. */
  :global(.js) .preview {
    position: fixed;
    top: 0;
    left: 0;
    right: auto;
    translate: var(--px, -999px) var(--py, -999px);
  }
</style>

<script>
  for (const li of document.querySelectorAll<HTMLElement>('[data-linha]')) {
    const p = li.querySelector<HTMLElement>('.preview');
    if (!p) continue;
    const move = (x: number, y: number) => {
      // Keep the card inside the viewport, to the right of the pointer when possible.
      const w = p.offsetWidth, h = p.offsetHeight;
      const px = Math.min(x + 24, innerWidth - w - 16);
      const py = Math.min(Math.max(y - h / 2, 16), innerHeight - h - 16);
      p.style.setProperty('--px', `${px}px`);
      p.style.setProperty('--py', `${py}px`);
    };
    li.addEventListener('pointermove', (e) => move(e.clientX, e.clientY));
    li.addEventListener('focusin', () => {
      const r = li.getBoundingClientRect();
      move(r.right - 300, r.top + r.height / 2);
    });
  }
</script>
