---
import type { Lang, Projeto } from '@content/types';
import { ui } from '@/i18n/ui';
import Midia from './Midia.astro';
import Tags from './Tags.astro';

interface Props { projeto: Projeto; lang: Lang }
const { projeto: p, lang } = Astro.props;
const base = lang === 'pt' ? '' : '/en';
---
<article class="group relative overflow-hidden rounded-xl border border-line bg-panel transition-[border-color,translate] duration-300 ease-out-soft hover:-translate-y-1 hover:border-accent/60">
  {p.midia && (
    <figure class="relative border-b border-line">
      <Midia midia={p.midia} lang={lang} class="block aspect-video w-full object-cover" />
      {p.midia.legenda && (
        <figcaption class="eyebrow absolute bottom-3 left-3 rounded-sm border border-line bg-panel px-2 py-1 text-ink">{p.midia.legenda[lang]}</figcaption>
      )}
    </figure>
  )}
  <div class="p-6 sm:p-7">
    <p class="eyebrow">{p.parceiro[lang]} · {p.ano}</p>
    <h3 class="mt-2 text-2xl font-semibold tracking-tight">
      {p.estudoDeCaso ? <a href={`${base}/projetos/${p.slug}`} class="after:absolute after:inset-0">{p.nome}</a> : p.nome}
    </h3>
    <p class="mt-3 max-w-[62ch] text-muted">{p.resumo[lang]}</p>
    <dl class="mt-5 grid grid-cols-3 border-t border-line">
      {p.numeros.map((n) => (
        <div class="flex flex-col-reverse justify-end pt-4 pr-2">
          <dt class="eyebrow">{n.rotulo[lang]}</dt>
          <dd class="font-mono text-xl font-semibold text-accent sm:text-2xl">{n.valor}</dd>
        </div>
      ))}
    </dl>
    <Tags itens={p.stack} class="mt-5" />
    <div class="relative z-10 mt-6 flex flex-wrap gap-2.5">
      {p.demoUrl && <a href={p.demoUrl} class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-ink">{ui.abrirSite[lang]} ↗</a>}
      {p.apresentacaoUrl && <a href={p.apresentacaoUrl} class="rounded-lg border border-line px-4 py-2 text-sm font-semibold hover:border-ink">{ui.modoApresentacao[lang]} ↗</a>}
      {p.estudoDeCaso && <a href={`${base}/projetos/${p.slug}`} class="rounded-lg border border-line px-4 py-2 text-sm font-semibold hover:border-ink">{ui.estudoDeCaso[lang]} →</a>}
    </div>
  </div>
</article>
