---
// Top bar on every page except the lab: always-visible main nav. On phones the nav drops to a
// second row that scrolls sideways, so all five links stay reachable.
import type { Lang } from '@content/types';
import { perfil } from '@content/perfil';
import { ui, outraRota } from '@/i18n/ui';

interface Props { lang: Lang; atual?: 'projetos' | 'sobre' | 'curriculo' | 'lab' | 'contato' }
const { lang, atual } = Astro.props;
const base = lang === 'pt' ? '' : '/en';
const links = [
  { id: 'projetos', href: `${base}/projetos`, label: ui.navProjetos[lang] },
  { id: 'sobre', href: `${base}/sobre`, label: lang === 'pt' ? 'Sobre' : 'About' },
  { id: 'curriculo', href: `${base}/curriculo`, label: ui.navCurriculo[lang] },
  { id: 'lab', href: `${base}/lab`, label: ui.navLab[lang] },
  { id: 'contato', href: `${base}/contato`, label: ui.navContato[lang] },
] as const;
---
<header class="sticky top-0 z-30 border-b border-line bg-paper/85 backdrop-blur print:hidden">
  <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-2 px-4 sm:h-14 sm:flex-nowrap sm:gap-4 sm:px-8">
    <a href={`${base}/`} class="flex h-12 shrink-0 items-center gap-2.5 font-semibold tracking-tight sm:h-auto" aria-label={lang === 'pt' ? 'Início' : 'Home'}>
      <img src={perfil.foto.src} alt="" width="28" height="28" class="size-7 rounded-full object-cover" />
      <span class="hidden md:inline">{perfil.nomeCurto}</span>
    </a>
    <nav aria-label={lang === 'pt' ? 'Principal' : 'Main'} class="order-last -mx-4 w-[calc(100%+2rem)] sem-barra overflow-x-auto border-t border-line px-2 sm:order-none sm:mx-0 sm:w-auto sm:overflow-visible sm:border-0 sm:px-0">
      <ul class="flex h-11 items-center justify-between gap-0.5 text-sm whitespace-nowrap sm:h-auto sm:justify-start sm:gap-1">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={atual === l.id ? 'page' : undefined}
              class="rounded-md px-2 py-1.5 text-muted transition-colors hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8 sm:px-3"
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-1">
      <a href={outraRota(Astro.url.pathname, lang)} hreflang={lang === 'pt' ? 'en' : 'pt-BR'} lang={lang === 'pt' ? 'en' : 'pt-BR'} class="rounded-md px-2 py-2 font-mono text-xs text-muted hover:text-ink">{lang === 'pt' ? 'EN' : 'PT'}</a>
      <button type="button" data-tema aria-label={ui.tema[lang]} class="grid size-9 place-items-center rounded-md text-muted hover:text-ink">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path></svg>
      </button>
    </div>
  </div>
</header>
