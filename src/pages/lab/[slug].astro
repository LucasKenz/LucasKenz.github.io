---
import { lab } from '@content/lab';
import LabPagina from '@/components/LabPagina.astro';

export function getStaticPaths() {
  return lab.filter((item) => !item.href).map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---
<LabPagina item={item} lang="pt" />
